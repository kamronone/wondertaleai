GENERATION_MODE=demo
OPENAI_API_KEY=
TEXT_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# Secure prototype (secure_main.py only): disabled by default.
ENABLE_REGISTRATION=false
ENABLE_TEXT_AI=false
AI_ALLOWED_EMAILS=
MAX_AI_STORIES_PER_DAY=10
DATABASE_URL=sqlite:///./secure_dev.sqlite3
STORY_TEXT_MODEL=gpt-5.5
# AUTH_SECRET must be generated privately and passed through the host secret manager.
# Never publish OPENAI_API_KEY, DATABASE_URL credentials, or AUTH_SECRET in Vite.

# Verified parent accounts: fail closed until SMTP and separate DB are configured.
REQUIRE_EMAIL_VERIFICATION=true
# Prefer Resend HTTP API in Vercel (requires verified sender domain).
# Keep these on the private FastAPI project, never in frontend/VITE_* vars.
RESEND_API_KEY=
MAIL_FROM=
# SMTP fallback when RESEND_API_KEY is not configured:
SMTP_HOST=
SMTP_PORT=465
# Encrypted SMTP only: port 465 (implicit TLS) or 587 (STARTTLS).
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Canonical HTTPS site origin. The site includes verification/reset screens; API access remains gated.
PUBLIC_APP_ORIGIN=
# Do not set REQUIRE_EMAIL_VERIFICATION=false outside a fully isolated test environment.
