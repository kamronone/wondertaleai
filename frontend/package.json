{
  "name": "wondertale-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:uz && tsc --noEmit && vite build",
    "check:uz": "node scripts/check-uzbek-orthography.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "check:images": "node scripts/check-classic-page-assets.mjs",
    "check:images:release": "node scripts/check-classic-page-assets.mjs --strict",
    "install:rapunzel:art": "node scripts/install-rapunzel-pngs.mjs",
    "reaction:gif:install": "node scripts/install-reaction-gifs.mjs",
    "predev": "npm run reaction:gif:install",
    "pretest": "npm run reaction:gif:install",
    "prebuild": "npm run reaction:gif:install",
    "check:dist": "node scripts/check-dist.mjs",
    "install:snow-white:art": "node scripts/install-snow-white-pngs.mjs",
    "publish:snow-white:art": "node scripts/publish-snow-white-pngs.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "esbuild": "^0.24.2"
  },
  "overrides": {
    "rollup": "4.68.7"
  }
}
